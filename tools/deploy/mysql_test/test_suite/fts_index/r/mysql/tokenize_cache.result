+--------------------------------------------------------+

create table t1 (id int primary key, title varchar(100), body text,
                 fulltext index fti(title, body) with parser ik) default charset utf8mb4;

insert into t1 values (1, '全文索引', '倒排索引是全文检索的核心数据结构');
insert into t1 values (2, '倒排索引', '全文索引的分词器热路径优化');
insert into t1 values (3, 'OceanBase', 'OceanBase 是一款稳定的数据库');

select count(*) from t1 where match(title, body) against('倒排索引');
+----------+
| count(*) |
+----------+
|        2 |
+----------+
select count(*) from t1 where match(title, body) against('倒排索引');
+----------+
| count(*) |
+----------+
|        2 |
+----------+
select id from t1 where match(title, body) against('倒排索引') order by id;
+----+
| id |
+----+
|  1 |
|  2 |
+----+
select id from t1 where match(title, body) against('倒排索引') order by id;
+----+
| id |
+----+
|  1 |
|  2 |
+----+

drop table if exists t1;
drop database if exists fts_tok_cache;
