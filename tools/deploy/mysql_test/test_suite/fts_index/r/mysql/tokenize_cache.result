drop database if exists fts_tok_cache;
create database fts_tok_cache;
use fts_tok_cache;
set ob_query_timeout = 10000000000;
result_format: 4
select tokenize('全文索引 分词器 热路径', 'ik');
+----------------------------------------------------+
| tokenize('全文索引 分词器 热路径', 'ik')           |
+----------------------------------------------------+
| ["分词器", "路径", "全文索引", "热"]               |
+----------------------------------------------------+
select tokenize('全文索引 分词器 热路径', 'ik');
+----------------------------------------------------+
| tokenize('全文索引 分词器 热路径', 'ik')           |
+----------------------------------------------------+
| ["分词器", "路径", "全文索引", "热"]               |
+----------------------------------------------------+
select tokenize('全文索引 分词器 热路径', 'ik');
+----------------------------------------------------+
| tokenize('全文索引 分词器 热路径', 'ik')           |
+----------------------------------------------------+
| ["分词器", "路径", "全文索引", "热"]               |
+----------------------------------------------------+

select tokenize('the quick brown fox', 'beng');
+-----------------------------------------+
| tokenize('the quick brown fox', 'beng') |
+-----------------------------------------+
| ["quick", "brown", "fox"]               |
+-----------------------------------------+
select tokenize('the quick brown fox', 'beng');
+-----------------------------------------+
| tokenize('the quick brown fox', 'beng') |
+-----------------------------------------+
| ["quick", "brown", "fox"]               |
+-----------------------------------------+

select tokenize('倒排索引', 'ik');
+--------------------------------+
| tokenize('倒排索引', 'ik')     |
+--------------------------------+
| ["倒排", "索引"]               |
+--------------------------------+
select tokenize('inverted index', 'beng');
+------------------------------------+
| tokenize('inverted index', 'beng') |
+------------------------------------+
| ["index", "inverted"]              |
+------------------------------------+
select tokenize('倒排索引', 'ik');
+--------------------------------+
| tokenize('倒排索引', 'ik')     |
+--------------------------------+
| ["倒排", "索引"]               |
+--------------------------------+
select tokenize('inverted index', 'beng');
+------------------------------------+
| tokenize('inverted index', 'beng') |
+------------------------------------+
| ["index", "inverted"]              |
+------------------------------------+
select tokenize('倒排索引', 'ik');
+--------------------------------+
| tokenize('倒排索引', 'ik')     |
+--------------------------------+
| ["倒排", "索引"]               |
+--------------------------------+

select tokenize('hello world', 'space');
+----------------------------------+
| tokenize('hello world', 'space') |
+----------------------------------+
| ["world", "hello"]               |
+----------------------------------+
select tokenize('hello world', 'beng');
+---------------------------------+
| tokenize('hello world', 'beng') |
+---------------------------------+
| ["world", "hello"]              |
+---------------------------------+
select tokenize('hello world', 'ngram');
+--------------------------------------------------+
| tokenize('hello world', 'ngram')                 |
+--------------------------------------------------+
| ["lo", "he", "ll", "or", "rl", "wo", "ld", "el"] |
+--------------------------------------------------+
select tokenize('hello world', 'space');
+----------------------------------+
| tokenize('hello world', 'space') |
+----------------------------------+
| ["world", "hello"]               |
+----------------------------------+
select tokenize('hello world', 'beng');
+---------------------------------+
| tokenize('hello world', 'beng') |
+---------------------------------+
| ["world", "hello"]              |
+---------------------------------+

select tokenize('hello world', 'space', '[{"output": "all"}]');
+---------------------------------------------------------+
| tokenize('hello world', 'space', '[{"output": "all"}]') |
+---------------------------------------------------------+
| {"tokens": [{"world": 1}, {"hello": 1}], "doc_len": 2}  |
+---------------------------------------------------------+
select tokenize('hello world', 'space', '[{"output": "default"}]');
+-------------------------------------------------------------+
| tokenize('hello world', 'space', '[{"output": "default"}]') |
+-------------------------------------------------------------+
| ["world", "hello"]                                          |
+-------------------------------------------------------------+
select tokenize('hello world', 'space', '[{"output": "all"}]');
+---------------------------------------------------------+
| tokenize('hello world', 'space', '[{"output": "all"}]') |
+---------------------------------------------------------+
| {"tokens": [{"world": 1}, {"hello": 1}], "doc_len": 2}  |
+---------------------------------------------------------+
select tokenize('hello world', 'ngram', '[{"output": "all"}, {"additional_args": [{"ngram_token_size": 2}]}]');
+--------------------------------------------------------------------------------------------------------------------+
| tokenize('hello world', 'ngram', '[{"output": "all"}, {"additional_args": [{"ngram_token_size": 2}]}]')            |
+--------------------------------------------------------------------------------------------------------------------+
| {"tokens": [{"lo": 1}, {"he": 1}, {"ll": 1}, {"or": 1}, {"rl": 1}, {"wo": 1}, {"ld": 1}, {"el": 1}], "doc_len": 8} |
+--------------------------------------------------------------------------------------------------------------------+
select tokenize('hello world', 'ngram', '[{"output": "all"}, {"additional_args": [{"ngram_token_size": 3}]}]');
+---------------------------------------------------------------------------------------------------------+
| tokenize('hello world', 'ngram', '[{"output": "all"}, {"additional_args": [{"ngram_token_size": 3}]}]') |
+---------------------------------------------------------------------------------------------------------+
| {"tokens": [{"hel": 1}, {"rld": 1}, {"orl": 1}, {"ell": 1}, {"llo": 1}, {"wor": 1}], "doc_len": 6}      |
+---------------------------------------------------------------------------------------------------------+
select tokenize('hello world', 'ngram', '[{"output": "all"}, {"additional_args": [{"ngram_token_size": 2}]}]');
+--------------------------------------------------------------------------------------------------------------------+
| tokenize('hello world', 'ngram', '[{"output": "all"}, {"additional_args": [{"ngram_token_size": 2}]}]')            |
+--------------------------------------------------------------------------------------------------------------------+
| {"tokens": [{"lo": 1}, {"he": 1}, {"ll": 1}, {"or": 1}, {"rl": 1}, {"wo": 1}, {"ld": 1}, {"el": 1}], "doc_len": 8} |
+--------------------------------------------------------------------------------------------------------------------+

select tokenize('OceanBase', 'beng');
