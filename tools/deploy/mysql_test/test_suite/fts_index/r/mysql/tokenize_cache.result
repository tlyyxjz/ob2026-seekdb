+-------------------------------+
| ["oceanbase"]                 |
+-------------------------------+
select tokenize('oceanbase', 'beng');
+-------------------------------+
| tokenize('oceanbase', 'beng') |
+-------------------------------+
| ["oceanbase"]                 |
+-------------------------------+
select tokenize('OceanBase', 'beng');
+-------------------------------+
| tokenize('OceanBase', 'beng') |
+-------------------------------+
| ["oceanbase"]                 |
+-------------------------------+
select tokenize('  a  b  ', 'space');
+-------------------------------+
| tokenize('  a  b  ', 'space') |
+-------------------------------+
| []                            |
+-------------------------------+
select tokenize('a b', 'space');
+--------------------------+
| tokenize('a b', 'space') |
+--------------------------+
| []                       |
+--------------------------+
select tokenize('  a  b  ', 'space');
+-------------------------------+
| tokenize('  a  b  ', 'space') |
+-------------------------------+
| []                            |
+-------------------------------+

