drop database if exists fts_perf;
create database fts_perf;
use fts_perf;
set ob_query_timeout = 10000000000;
set ob_trx_timeout = 10000000000;
result_format: 4
create table t_pk(id bigint primary key, c1 varchar(256), c2 text);
create table t_heap(id bigint, c1 varchar(256), c2 text);

set cte_max_recursion_depth = 10000;
set group_concat_max_len = 1000000;
insert into t_pk
  with recursive s(n) as (select 1 union all select n + 1 from s where n < 700)
  select n,
         case n % 3 when 0 then concat('Apple banana ORANGE ', n)
                    when 1 then concat('全文索引 分词器 测试 ', n)
                    else concat('Mixed 数据库 Database Ünïcode Straße ', n) end,
         concat('row ', n, ' fox', n % 5, ' jumps dog', n % 7, ' 数据库', n % 5, ' 性能',
                if(n % 7 = 0, ' cherry kiwi lemon mango melon peach pear plum lime grape fig date', ''))
  from s;
insert into t_heap select * from t_pk;

insert into t_pk
  with recursive s(n) as (select 1 union all select n + 1 from s where n < 600)
  select 1001, 'long', group_concat(concat('w', 1000 + n) separator ' ') from s;
insert into t_heap select * from t_pk where id = 1001;
insert into t_pk values (1002, '', ''), (1003, null, null);
insert into t_heap values (1002, '', ''), (1003, null, null);

alter table t_pk add fulltext index ft_pk_beng(c1, c2) with parser beng;
alter table t_heap add fulltext index ft_heap_beng(c1, c2) with parser beng;
alter table t_pk add fulltext index ft_pk_ik(c2) with parser ik;

select count(*) from t_pk where match(c1, c2) against('fox1');
